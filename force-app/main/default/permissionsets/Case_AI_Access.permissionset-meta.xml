<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Case AI Integration Access</label>
    <description>Grants access to Apex controllers, Case AI suggestion object/fields, and the Case AI LWC.</description>

    <!-- Apex class access -->
    <classAccesses>
        <apexClass>CaseIntegrationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>AICallbackRest</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CaseAISummaryController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Object permissions for custom object Case_AI_Suggestion__c -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Case_AI_Suggestion__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Field permissions for Case_AI_Suggestion__c -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Case_AI_Suggestion__c.Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case_AI_Suggestion__c.Suggested_Reply__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case_AI_Suggestion__c.Confidence__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case_AI_Suggestion__c.Case__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Field permissions for Case fields added -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.AI_Summary__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Case.AI_Confidence__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Note: LWC exposure is governed by component metadata and page availability; explicit componentAccesses is not supported here. -->
</PermissionSet>
